# CesiumJS Ion Access Token (free at https://cesium.com/ion/tokens)
NEXT_PUBLIC_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# Google Maps API Key (for Photorealistic 3D Tiles - optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# GDELT API (no key required - open access)
# GDELT_API_BASE=https://api.gdeltproject.org

# ACLED API (register at https://acleddata.com/register/)
ACLED_API_KEY=your_acled_api_key_here
ACLED_EMAIL=your_email_here

# OpenSky Network (register at https://opensky-network.org)
OPENSKY_USERNAME=your_username_here
OPENSKY_PASSWORD=your_password_here
